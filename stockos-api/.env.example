# =============================================================================
# StockOS API — complete environment template
# Copy to `.env` and replace placeholders. Never commit `.env`.
# =============================================================================

# ── Application ─────────────────────────────────────────────────────────────
NODE_ENV="development"
PORT=3001
# Browser origin for CORS + cookie-aware flows (Next.js app URL)
FRONTEND_URL="http://localhost:3000"
# Optional: comma-separated extra CORS origins (e.g. https://your-app.vercel.app)
# CORS_ORIGINS="https://your-app.vercel.app"

# ── PostgreSQL (Prisma) ─────────────────────────────────────────────────────
# Get BOTH strings from Supabase Dashboard → your project → Connect (top bar).
# Ensure the project is not paused (Dashboard will show “Restore” if it is).
#
# Why P1001 on Windows? The “Direct connection” host db.<ref>.supabase.co is often
# IPv6-only. If your network has no IPv6 path, Prisma fails before the API can start.
# Fix: use the Shared Pooler URIs from “Connect”, not the direct host, until you add
# the IPv4 add-on (paid) or have working IPv6.
#
# 1) DATABASE_URL — “Transaction pooler” URI (often db.<ref>.supabase.co:6543).
#    For Prisma you MUST append (or keep) ?pgbouncer=true
#    Example suffix: ?pgbouncer=true&sslmode=require
#
# 2) DIRECT_DATABASE_URL — “Session pooler” URI (aws-0- or aws-1-<region>.pooler.supabase.com:5432,
#    user is usually postgres.<project-ref>). Used for migrations / schema engine.
#    Copy exactly from Connect → Session mode — do not guess the region or aws-0 vs aws-1.
#
# URL-encode special characters in the password (e.g. @ → %40).

DATABASE_URL="postgresql://postgres:YOUR_PASSWORD@db.YOUR_PROJECT_REF.supabase.co:6543/postgres?pgbouncer=true&sslmode=require"
DIRECT_DATABASE_URL="postgresql://postgres.YOUR_PROJECT_REF:YOUR_PASSWORD@aws-1-REGION.pooler.supabase.com:5432/postgres?sslmode=require"

# ── JWT (NestJS-issued access/refresh + 2FA temp tokens) ────────────────────
# Generate strong random strings, each at least 32 characters
JWT_ACCESS_SECRET="change-me-minimum-thirty-two-characters-long-secret"
JWT_REFRESH_SECRET="change-me-another-thirty-two-chars-minimum-secret"
JWT_ACCESS_EXPIRES="15m"
JWT_REFRESH_EXPIRES="7d"

# ── Redis (sessions blacklist, rate limiting, refresh token checks) ───────────
REDIS_URL="redis://localhost:6379"

# ── Password hashing (local / legacy accounts) ──────────────────────────────
BCRYPT_ROUNDS=12

# ── Supabase Auth (optional block — omit entirely for DB-only local dev) ────
# If SUPABASE_URL is set, set SERVICE_ROLE_KEY (+ ANON_KEY for password change). JWT secret is optional for ES256 projects.
# Dashboard: Project Settings → API (URL, anon, service_role)
SUPABASE_URL="https://YOUR_PROJECT_REF.supabase.co"
SUPABASE_ANON_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."
SUPABASE_SERVICE_ROLE_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."
# Optional: only for HS256 / legacy JWT secret verification. Asymmetric signing (ES256) is verified via JWKS at SUPABASE_URL/auth/v1/.well-known/jwks.json automatically.
SUPABASE_JWT_SECRET="your-supabase-jwt-secret"
# Shared secret header `x-webhook-secret` for POST /api/v1/webhooks/supabase/on-signup
SUPABASE_WEBHOOK_SECRET="generate-a-long-random-string"
# New self-signup users: "true" = ACTIVE after sync; "false" = PENDING (admin approval)
SUPABASE_AUTO_APPROVE_SIGNUPS="true"

# ── Cloudflare R2 (S3-compatible storage — product images, documents) ───────
# Optional: if unset, storage endpoints return 503 until configured
CLOUDFLARE_ACCOUNT_ID="your-cloudflare-account-id"
R2_ACCESS_KEY_ID="your-r2-token-access-key-id"
R2_SECRET_ACCESS_KEY="your-r2-token-secret-access-key"
R2_BUCKET_NAME="stockos-production"
# Public bucket base URL, no trailing slash (e.g. https://pub-xxxxx.r2.dev)
R2_PUBLIC_URL="https://pub-xxxxx.r2.dev"
