# =============================================================================
# StockOS VPS — copy to .env and fill from Supabase docker/.env values
# =============================================================================

# Public URLs (use your VPS IP or domain — no trailing slash)
VPS_HOST=187.127.137.103
FRONTEND_URL=http://187.127.137.103
NEXT_PUBLIC_APP_URL=http://187.127.137.103
NEXT_PUBLIC_API_URL=http://187.127.137.103
# Browser talks to Supabase via nginx on same host
NEXT_PUBLIC_SUPABASE_URL=http://187.127.137.103
SUPABASE_URL=http://supabase-kong:8000

# From /opt/supabase/docker/.env after you generate secrets:
#   ANON_KEY → both keys below
#   SERVICE_ROLE_KEY
#   JWT_SECRET
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWT_SECRET=
SUPABASE_WEBHOOK_SECRET=change-me-webhook-secret
SUPABASE_AUTO_APPROVE_SIGNUPS=true

# Postgres inside Supabase stack (container DNS name is usually db)
# Password = POSTGRES_PASSWORD from supabase docker/.env
DATABASE_URL=postgresql://postgres:YOUR_POSTGRES_PASSWORD@db:5432/postgres
DIRECT_DATABASE_URL=postgresql://postgres:YOUR_POSTGRES_PASSWORD@db:5432/postgres

# Nest JWT (generate with: openssl rand -hex 32)
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
BCRYPT_ROUNDS=12
