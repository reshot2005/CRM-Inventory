# Scratch-only credentials for Week 4 org-migration rehearsal.
# Copy to `.env.scratch` (never commit `.env.scratch`).
# Load via: copy values into the shell env, or merge into a local untracked file
# that `npm run db:test-org-migration` can read (script also reads `.env.local`).

# Must be a DIFFERENT project from the live StockOS app.
SUPABASE_SCRATCH_PROJECT_REF="YOUR_SCRATCH_PROJECT_REF"
SUPABASE_SCRATCH_URL="https://YOUR_SCRATCH_PROJECT_REF.supabase.co"
SUPABASE_SCRATCH_ANON_KEY="your-scratch-anon-key"
SUPABASE_SCRATCH_SERVICE_ROLE_KEY="your-scratch-service-role-key"
SUPABASE_SCRATCH_DB_URL="postgresql://postgres.YOUR_SCRATCH_PROJECT_REF:PASSWORD@HOST:5432/postgres"

# Existing users on the scratch clone (not production passwords in git).
W4_TEST_OWNER_EMAIL="owner-scratch@example.test"
W4_TEST_OWNER_PASSWORD="replace-me"
W4_TEST_OUTSIDER_EMAIL="outsider-scratch@example.test"
W4_TEST_OUTSIDER_PASSWORD="replace-me"

# Optional: live app URL used only so the rehearsal can REFUSE if scratch == live.
# NEXT_PUBLIC_SUPABASE_URL="https://LIVE_PROJECT_REF.supabase.co"
# SUPABASE_DB_URL="postgresql://postgres.LIVE_PROJECT_REF:PASSWORD@HOST:5432/postgres"
