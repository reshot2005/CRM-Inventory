# Copy to .env.local (Next.js loads this automatically; never commit .env.local)

# Supabase — Project Settings → API (same project as the backend)
NEXT_PUBLIC_SUPABASE_URL="https://YOUR_PROJECT_REF.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."
# Server-only — never expose to the browser
SUPABASE_SERVICE_ROLE_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."
# Server/tooling only — use the pooler URI and URL-encode the password.
SUPABASE_DB_URL="postgresql://postgres.PROJECT_REF:PASSWORD@HOST:5432/postgres"
# Required only for destructive migration rehearsals. Must point to a clone,
# never the development or production database.
SUPABASE_SCRATCH_DB_URL="postgresql://postgres.SCRATCH_REF:PASSWORD@HOST:5432/postgres"
SUPABASE_SCRATCH_URL="https://YOUR_SCRATCH_PROJECT_REF.supabase.co"
SUPABASE_SCRATCH_ANON_KEY="your-scratch-anon-key"
SUPABASE_SCRATCH_SERVICE_ROLE_KEY="your-scratch-service-role-key"
SUPABASE_SCRATCH_PROJECT_REF="YOUR_SCRATCH_PROJECT_REF"
# Existing, confirmed users copied into the scratch clone. Never use production
# credentials and never commit their actual values.
W4_TEST_OWNER_EMAIL="owner-scratch@example.test"
W4_TEST_OWNER_PASSWORD="replace-me"
W4_TEST_OUTSIDER_EMAIL="outsider-scratch@example.test"
W4_TEST_OUTSIDER_PASSWORD="replace-me"

# Backend API (no trailing slash)
NEXT_PUBLIC_API_URL="http://localhost:3001"
# Public site URL — used in confirmation/reset links
NEXT_PUBLIC_APP_URL="http://localhost:1234"

# Optional: hostname only for next/image (R2 public bucket), e.g. pub-xxxxx.r2.dev
# NEXT_PUBLIC_R2_PUBLIC_HOSTNAME="pub-xxxxx.r2.dev"
