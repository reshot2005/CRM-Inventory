# StockOS Vite app → Nest API (no trailing slash). Supabase email/password login still hits POST /auth/sync on this API.
# From repo root: npm run dev:stack (Vite + API) or npm run dev:api in a second terminal.
VITE_API_URL=http://localhost:3001/api/v1

# Public URL of this Vite dev server (used for Supabase email confirmation redirect)
VITE_APP_URL=http://localhost:8080

# Supabase (same project as stockos-web). Enables email sign-up + confirmation on /register.
# You can set either these VITE_* vars here OR use stockos-web/.env.local with
# NEXT_PUBLIC_SUPABASE_URL / NEXT_PUBLIC_SUPABASE_ANON_KEY — vite.config merges them.
# In Supabase Dashboard → Authentication → URL configuration, add your Vite origin + /auth/callback
# (this project uses port 8080 by default): http://localhost:8080/auth/callback
# Enable "Confirm email" under Authentication → Providers → Email.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
