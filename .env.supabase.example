# Supabase Project Settings (get from: supabase.com/dashboard → Settings → API)
SUPABASE_URL="https://your-project-ref.supabase.co"
SUPABASE_ANON_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."
SUPABASE_SERVICE_ROLE_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."
SUPABASE_JWT_SECRET="your-jwt-secret-from-supabase-dashboard"

# Database — pooler for app traffic (port 6543)
DATABASE_URL="postgresql://postgres.xxxx:password@aws-0-ap-south-1.pooler.supabase.com:6543/postgres"

# Direct connection for Prisma migrations only (port 5432)
DIRECT_DATABASE_URL="postgresql://postgres:password@db.xxxx.supabase.co:5432/postgres"

# Webhook HMAC / shared secret (you choose; set same in Supabase webhook header)
SUPABASE_WEBHOOK_SECRET="random-32-char-string-you-generate"
